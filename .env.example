# Base de datos (nunca uses la URL de produccion para pruebas)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# URLs y autenticacion
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
REPRESENTATIVE_RESET_CODE_SECRET=replace-with-a-different-32-byte-random-secret

# Operacion y pagos
CRON_SECRET=replace-with-a-random-secret
MP_ENCRYPTION_KEY=64-hex-characters-32-bytes
MP_WEBHOOK_SECRET=replace-with-mercado-pago-webhook-secret

# Limites de solicitudes
UPSTASH_REDIS_REST_URL=https://YOUR-REDIS.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-token

# Notificaciones push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=replace-with-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-vapid-private-key
VAPID_SUBJECT=mailto:admin@example.com

# Opcionales
RESEND_API_KEY="
NEXT_PUBLIC_SENTRY_DSN="
SENTRY_ORG="
SENTRY_PROJECT="
SENTRY_AUTH_TOKEN="
MAINTENANCE_MODE=false
