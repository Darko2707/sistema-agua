# Copia este archivo como .env.staging. Nunca subas .env.staging a Git.
# Usa solo URLs y secretos del entorno staging, nunca de produccion.
DATABASE_URL=postgresql://USER:PASSWORD@STAGING_HOST:5432/DATABASE?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@STAGING_DIRECT_HOST:5432/DATABASE?sslmode=require

BETTER_AUTH_URL=https://STAGING_APP_URL
NEXT_PUBLIC_APP_URL=https://STAGING_APP_URL
BETTER_AUTH_SECRET=replace-with-a-staging-secret-of-at-least-32-random-bytes
REPRESENTATIVE_RESET_CODE_SECRET=replace-with-a-different-staging-secret
CRON_SECRET=replace-with-a-staging-secret

# Solo credenciales sandbox; no uses secretos ni tokens de produccion.
MP_ENCRYPTION_KEY=64-hex-characters-32-bytes
MP_WEBHOOK_SECRET=replace-with-sandbox-webhook-secret

UPSTASH_REDIS_REST_URL=https://YOUR-STAGING-REDIS.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-staging-token
NEXT_PUBLIC_VAPID_PUBLIC_KEY=replace-with-staging-public-key
VAPID_PRIVATE_KEY=replace-with-staging-private-key
VAPID_SUBJECT=mailto:admin@example.com
MAINTENANCE_MODE=false
